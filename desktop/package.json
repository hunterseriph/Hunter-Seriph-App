{
  "name": "hunter-seriph-pc",
  "productName": "Hunter Seriph",
  "version": "1.0.0",
  "private": true,
  "description": "Hunter Seriph app for PC: Twitch live, YouTube videos, games, projects and merch.",
  "author": "Hunter Seriph",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.hunterseriph.app",
    "productName": "Hunter Seriph",
    "files": ["main.js", "icon.png", "www/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "icon": "icon.png" },
    "portable": { "artifactName": "Hunter-Seriph-PC.exe" }
  }
}
